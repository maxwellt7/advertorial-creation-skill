ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=advertorial-corpus
PINECONE_ENVIRONMENT=us-east-1
# Must match your Pinecone index dimension. text-embedding-3-large supports
# any dimension up to 3072 via OpenAI's `dimensions=` parameter (Matryoshka).
EMBEDDING_DIMENSIONS=2048
# Absolute path to the directory containing /advertorials and /facebook_ads markdown files (the listicle_deliverables corpus). Example: /path/to/listicle_deliverables
ADVERTORIAL_CORPUS_PATH=
# Absolute path to the directory where per-run state and artifacts will be written.
ADVERTORIAL_RUNS_PATH=
COST_CEILING_USD=5.00
